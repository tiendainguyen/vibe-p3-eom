{
  "permissions": {
    "deny": [
      "Read(.env)",
      "Read(.env.*)",
      "Read(*.pem)",
      "Read(*.key)",
      "Read(*credentials*)",
      "Read(*secret*)",
      "Write(.env)",
      "Write(.env.*)",
      "Write(*.pem)",
      "Write(*.key)",
      "Write(CLAUDE.md)",
      "Write(.claude/settings.json)",
      "Write(.claude/rules/**)",
      "Bash(rm -rf *)",
      "Bash(git push --force*)",
      "Bash(git push * --force*)",
      "Bash(git reset --hard*)",
      "Bash(curl *)",
      "Bash(wget *)",
      "Bash(ssh *)",
      "Bash(git commit*--no-verify*)",
      "Bash(npx *)",
      "Bash(chmod 777*)",
      "Bash(npm publish*)",
      "Bash(python*-c *)",
      "Bash(node -e *)",
      "Bash(bash -c *)",
      "Bash(sh -c *)",
      "Bash(eval *)"
    ],
    "allow": [
      "Read(src/**)",
      "Read(tests/**)",
      "Read(docs/**)",
      "Read(package.json)",
      "Read(tsconfig.json)",
      "Read(README.md)",
      "Read(.env.example)",
      "Write(src/**)",
      "Write(tests/**)"
    ],
    "ask": [
      "Bash(npm install*)",
      "Bash(pnpm install*)",
      "Bash(pnpm add*)",
      "Bash(git commit*)",
      "Bash(git push*)",
      "Bash(git merge*)",
      "Bash(git checkout*)",
      "Write(package.json)",
      "Write(docs/**)"
    ]
  }
}